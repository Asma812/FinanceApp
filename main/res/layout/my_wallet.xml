<!-- Layout file remains the same as before -->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/white"> <!-- Couleur de fond bleu pour la page -->

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/white"
    android:elevation="4dp"
    android:theme="@style/ThemeOverlay.AppCompat.ActionBar"
    app:title="My Wallet"
    app:titleTextColor="@android:color/black" />

    <!-- Your existing content -->
    <!-- Liste déroulante pour sélectionner la catégorie de dépenses -->
    <Spinner
        android:id="@+id/spinnerCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:prompt="@string/select_category"
        android:entries="@array/categories"
        android:layout_marginTop="26dp"
        tools:ignore="HardcodedText" />

    <!-- Champ de saisie pour le montant de la dépense -->
    <EditText
        android:id="@+id/editTextAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter_amount"
        android:layout_marginTop="22dp"
        android:inputType="numberDecimal"
        android:autofillHints="" />

    <!-- Calendrier ou champ de date pour enregistrer la date de la dépense -->
    <DatePicker
        android:id="@+id/datePicker"
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:layout_marginTop="26dp"
        android:theme="@style/MyDatePickerTheme" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        tools:ignore="ExtraText">

        <Button
            android:id="@+id/buttonSave"
            android:layout_width="163dp"
            android:layout_height="43dp"
            android:text="Save"
            android:backgroundTint="@color/Blue"
            android:textColor="#000000"
            style="?android:attr/buttonBarButtonStyle" />

        <Button
            android:id="@+id/buttonCancel"
            android:layout_width="163dp"
            android:layout_height="43dp"
            android:backgroundTint="@color/Blue"
            android:textColor="#000000"
            android:text="Cancel"
            style="?android:attr/buttonBarButtonStyle" />
    </LinearLayout>

</androidx.appcompat.widget.LinearLayoutCompat>
