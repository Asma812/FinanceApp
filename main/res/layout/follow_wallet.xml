<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/white"> <!-- Set background color to blue -->

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/white"
        android:elevation="4dp"
        android:theme="@style/ThemeOverlay.AppCompat.ActionBar"
        app:title="Follow Wallet"
        app:titleTextColor="@android:color/black" />

    <!-- LineChart -->
    <com.github.mikephil.charting.charts.LineChart
        android:id="@+id/lineChart"
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:layout_marginTop="16dp"
        tools:ignore="MissingClass" />


    <!-- Button to Save Settings -->
    <!-- Your existing content for the button to save settings -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"> <!-- Set background color to white -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Notification options"
            android:textStyle="bold"
            android:paddingLeft="30dp"
            android:layout_marginTop="16dp" />

        <!-- Container for Important Transactions CheckBox -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/Bluee"
            android:padding="8dp"
            android:layout_marginTop="20dp">

            <CheckBox
                android:id="@+id/checkBoxImportantTransactions"
                android:layout_width="341dp"
                android:layout_height="25dp"
                android:layout_weight="1"
                android:buttonTint="@color/Blue"
                android:paddingLeft="8dp"
                android:text="Large Transactions" />

        </LinearLayout>

        <!-- Container for Unusual Expenses CheckBox -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/Bluee"
            android:padding="8dp"
            android:layout_marginTop="20dp">

            <CheckBox
                android:id="@+id/checkBoxUnusualExpenses"
                android:layout_width="341dp"
                android:layout_height="21dp"
                android:layout_weight="1"
                android:buttonTint="@color/Blue"
                android:paddingLeft="8dp"
                android:text="Unusual expenses" />

        </LinearLayout>

        <!-- Container for Payment Deadlines CheckBox -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/Bluee"
            android:padding="8dp"
            android:layout_marginTop="20dp">

            <CheckBox
                android:id="@+id/checkBoxPaymentDeadlines"
                android:layout_width="341dp"
                android:layout_height="25dp"
                android:layout_weight="1"
                android:buttonTint="@color/Blue"
                android:paddingLeft="8dp"
                android:text="Payment deadlines" />

        </LinearLayout>

        <!-- Add additional LinearLayouts with CheckBoxes as needed -->

    </LinearLayout>

    <!-- Bouton Enregistrer les paramètres -->
    <Button
        android:id="@+id/buttonSaveSettings"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:backgroundTint="@color/Blue"
        android:text="Save settings"
        android:layout_marginTop="16dp"
        tools:ignore="DuplicateIds" />

</androidx.appcompat.widget.LinearLayoutCompat>
