<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CalendarHeaderAppearance">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="CalendarDateAppearance">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@android:color/black</item>
    </style>

    <style name="CalendarWeekdayAppearance">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@android:color/darker_gray</item>
    </style>
    <style name="MyDatePickerTheme" parent="Theme.AppCompat.Light.Dialog">
        <!-- Couleur du fond du calendrier -->
        <item name="android:background">#FFFFFF</item>
        <!-- Couleur du texte des dates -->
        <item name="android:textColorPrimary">@android:color/black</item>
        <!-- Couleur de la sélection -->
        <item name="colorAccent">#FF4081</item>
    </style>

</resources>